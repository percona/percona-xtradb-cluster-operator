	wait_pitr_pod_ready
	desc 'check data after backup' $restore
	compare_data "$cluster" "$compare" "no-proxy" "-P 3306" "test" "test"
	kubectl_bin delete -f "$test_dir/conf/${restore}.yaml"
}

