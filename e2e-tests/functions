compare_data() {
	local cluster=$1
	local compare=$2
	local use_proxy=${3:-"false"}
	local port=${4:-"-P 3306"}
	local database=${5:-"myApp"}
	local table=${6:-"myApp"}
	local size

	local root_pass
	root_pass=$(get_password "${cluster}" "root")

	if [[ ${use_proxy} == true || ${use_proxy} == "use-proxy" ]]; then
		local host
		host=$(get_proxy "${cluster}")
		if [[ -z $host ]]; then
			echo "No proxy service found for cluster ${cluster}"
			exit 1
		fi

		compare_mysql_cmd "${compare}" \
			"SELECT id FROM ${database}.${table} ORDER BY id;" \
			"-h ${host} ${port} -uroot -p'${root_pass}'"
	else
		size="$(get_pxc_size "${cluster}")"
		for i in $(seq 0 $((size - 1))); do
			compare_mysql_cmd "${compare}" \
				"SELECT id FROM ${database}.${table} ORDER BY id;" \
				"-h ${cluster}-pxc-${i}.${cluster}-pxc ${port} -uroot -p'${root_pass}'"
		done
	fi
}

write_data() {
	local cluster=$1
	local id=$2
	local use_proxy=${3:-"false"}
	local port=${4:-"-P 3306"}
	local database=${5:-"myApp"}
	local table=${6:-"myApp"}

	local root_pass
	root_pass=$(get_password "${cluster}" "root")
	proxy=$(get_proxy "${cluster}")
	if [[ (${use_proxy} == true || ${use_proxy} == "use-proxy") && -n $proxy ]]; then
		host="-h ${proxy}"
	else
		host="-h ${cluster}-pxc-0.${cluster}-pxc"
	fi

	run_mysql \
		"INSERT IGNORE ${database}.${table} (id) VALUES (${id})" \
		"${host} ${port} -uroot -p'${root_pass}'"
}

