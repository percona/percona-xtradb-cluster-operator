get_container_options() {
	local backup_name=$1
	local cluster_name=$2

	local backup_options
	backup_options=$(kubectl_bin get pxc-backup "$backup_name" -o json | jq -c '.spec.containerOptions // empty')
	if [[ -n $backup_options ]]; then
		echo "$backup_options"
		return
	fi

	local storage_name
	storage_name=$(kubectl_bin get pxc-backup "$backup_name" -o jsonpath='{.spec.storageName}')
	local storage_options
	storage_options=$(kubectl_bin get pxc "$cluster_name" -o json | jq -c --arg s "$storage_name" '.spec.backup.storages[$s].containerOptions // empty')
	if [[ -n $storage_options ]]; then
		echo "$storage_options"
		return
	fi
}

check_backup_container_options() {
	local backup_name=$1
	local cluster_name=$2
	local backup_job="xb-${backup_name}"

	local xbcloud_args
	xbcloud_args=$(kubectl_bin get job "${backup_job}" -o json \
		| jq -r '.spec.template.spec.containers[]
			| select(.name == "xtrabackup")
			| .env[]?
			| select(.name == "XBCLOUD_EXTRA_ARGS")
			| .value')
	if ! echo "${xbcloud_args}" | grep -E -- '--parallel=2'; then
		echo "xbcloud container options were not applied for backup ${backup_name}"
		exit 1
	fi

	local xtrabackup_args
	xtrabackup_args=$(kubectl_bin get job "${backup_job}" -o json \
		| jq -r '.spec.template.spec.containers[]
			| select(.name == "xtrabackup")
			| .env[]?
			| select(.name == "XB_EXTRA_ARGS")
			| .value')
	if ! echo "${xtrabackup_args}" | grep -E -- '--parallel=4'; then
		echo "xtrabackup container options were not applied for backup ${backup_name}"
		exit 1
	fi

	local xbstream_args
	xbstream_args=$(kubectl_bin get job "${backup_job}" -o json \
		| jq -r '.spec.template.spec.containers[]
			| select(.name == "xtrabackup")
			| .env[]?
			| select(.name == "XBSTREAM_EXTRA_ARGS")
			| .value')
	if ! echo "${xbstream_args}" | grep -E -- '--parallel=3'; then
		echo "xbstream container options were not applied for backup ${backup_name}"
		exit 1
	fi

	local pxc_pod="${cluster_name}-pxc-0"
	if ! kubectl_bin logs "${pxc_pod}" -c xtrabackup | grep -E 'xtrabackupCmd.*--parallel=4'; then
		echo "xtrabackup container options were not reflected in ${pxc_pod} logs for backup ${backup_name}"
		exit 1
	fi
	if ! kubectl_bin logs "${pxc_pod}" -c xtrabackup | grep -E 'xbcloudCmd.*--parallel=2'; then
		echo "xbcloud container options were not reflected in ${pxc_pod} logs for backup ${backup_name}"
		exit 1
	fi
}

run_recovery_from_source() {
	local storage_type=${1:-s3}
	local backup_name=${2:-on-demand-backup-aws-s3}
	local remove_bucket_or_container_name=${3:-""}
	local remove_prefix_from_destination=${4:-""}

	local remove_options=""
	if [ -n "$remove_bucket_or_container_name" ]; then
		remove_options=", .$storage_type.bucket, .$storage_type.container"
	fi

	local remove_prefix='test'
	if [ -n "${remove_prefix_from_destination}" -a -z "${remove_bucket_or_container_name}" ]; then
		remove_prefix="$storage_type"
	fi

	desc "$storage_type restore with backup source"
	local restore_name="on-demand-backup-$storage_type"

	local restore_json
	restore_json=$(jq ".metadata.name=\"$restore_name\"" "$test_dir/conf/restore-from-source-backup.json")

	local container_options
	container_options=$(get_container_options "$backup_name" "$cluster")
	if [[ -n $container_options ]]; then
		restore_json=$(echo "$restore_json" | jq --argjson opts "$container_options" '.spec.containerOptions=$opts')
	fi

	local backup_source_json
	backup_source_json=$(kubectl_bin get pxc-backup "$backup_name" -o json \
		| jq -c '.status | {'"$storage_type"', destination} | del(.'"$storage_type"'.endpointUrl, .'"$storage_type"'.storageClass '"$remove_options"')' \
		| $sed "s|$remove_prefix://||")
	echo "$restore_json" \
		| jq ".spec.backupSource=$backup_source_json" \
		| kubectl_bin apply -f -

	sleep 30
	wait_for_running "$cluster-proxysql" 1
	wait_for_running "$cluster-pxc" 3
	sleep 30
	desc 'check data after backup from source'
	compare_mysql_cmd "select-1" "SELECT * from myApp.myApp;" "-h $cluster-pxc-0.$cluster-pxc -uroot -proot_password"
	compare_mysql_cmd "select-1" "SELECT * from myApp.myApp;" "-h $cluster-pxc-1.$cluster-pxc -uroot -proot_password"
	compare_mysql_cmd "select-1" "SELECT * from myApp.myApp;" "-h $cluster-pxc-2.$cluster-pxc -uroot -proot_password"
}

wait_for_upload_to_start() {
	local pod_name=$1
	local container="${2:-xtrabackup}"
	local pattern="${3:-successfully uploaded chunk}"
	local max_attempts=100

	local container_arg=""
	[[ -n "$container" ]] && container_arg="-c $container"

	local attempts=0
	until kubectl_bin logs ${pod_name} ${container_arg} 2>/dev/null | grep -qF "$pattern"; do
		sleep 1
		let attempts+=1
		if [ $attempts -ge $max_attempts ]; then
			echo "Upload did not start on time"
			exit 1
		fi
	done

	return 0
}

run_backup_with_delete() {
	local backup_name=$1

	desc "make backup ${backup_name}"
	kubectl_bin apply \
		-f $test_dir/conf/${backup_name}.yml
	if ! delete_backup_pod ${backup_name}; then
		echo "Skipping cloud storage cleanup check: backup completed before pod could be deleted."
		wait_backup "${backup_name}"
		return 0
	fi
	wait_backup "${backup_name}"
	check_cloud_storage_cleanup "${backup_name}"
}

delete_backup_pod() {
	local backup_name=$1
	desc "Delete ${backup_name} pod during backup"

	local cluster_name
	cluster_name=$(kubectl_bin get pxc-backup ${backup_name} -o jsonpath='{.spec.pxcCluster}')
	if [[ -z $cluster_name ]]; then
		echo "Cluster name is not set on backup ${backup_name}"
		exit 1
	fi

	sleep 2
	local backup_pod
	backup_pod=$(kubectl_bin get pods --selector=percona.com/backup-job-name=xb-${backup_name} -o jsonpath='{.items[].metadata.name}')
	echo "Waiting for pod/${backup_pod} to become Running"
	kubectl_bin wait --for=jsonpath='{.status.phase}'=Running pod/${backup_pod} --timeout=120s

	echo "Waiting for upload to start"
	if [[ "$PXCO_FEATURE_GATES" == *"XtrabackupSidecar=true"* ]]; then
		wait_for_upload_to_start "${cluster_name}-pxc-0" "xtrabackup" "successfully uploaded chunk"
	else
		wait_for_upload_to_start "${backup_pod}" "" ".ibd."
	fi

	local pod_phase
	pod_phase=$(kubectl_bin get pod "${backup_pod}" -o jsonpath='{.status.phase}' 2>/dev/null || echo "NotFound")
	if [[ "${pod_phase}" != "Running" ]]; then
		echo "Backup pod is no longer running (phase: ${pod_phase}). Backup completed before pod could be deleted."
		return 1
	fi

	kubectl_bin delete pod --force "$backup_pod"
}

check_cloud_storage_cleanup() {
	local backup_name=$1

	desc "Check storage cleanup of ${backup_name}"
	if [[ $(kubectl_bin get events --field-selector involvedObject.kind=Job,involvedObject.name=xb-${backup_name} | grep -c "Created pod") == '1' ]]; then
		echo "Warning: only 1 pod was started by the Job. Backup completed before pod deletion took effect. Skipping cleanup check."
		return 0
	fi

	if [[ "$PXCO_FEATURE_GATES" == *"XtrabackupSidecar=true"* ]]; then
		local cluster_name
		cluster_name=$(kubectl_bin get pxc-backup ${backup_name} -o jsonpath='{.spec.pxcCluster}')
		if [[ -z $cluster_name ]]; then
			echo "Cluster name is not set on backup ${backup_name}"
			exit 1
		fi
		local pxc_pod="${cluster_name}-pxc-0"
		if kubectl_bin logs ${pxc_pod} -c xtrabackup | grep 'Deleting Backup'; then
			echo "Cleanup was performed."
		else
			echo "Something went wrong. Delete was not performed."
			kubectl_bin logs ${pxc_pod} -c xtrabackup
			exit 1
		fi
		return 0
	fi

	local backup_pod
	backup_pod=$(kubectl_bin get pods --selector=percona.com/backup-job-name=xb-${backup_name} -o jsonpath='{.items[].metadata.name}')
	if [[ $IMAGE_PXC =~ 5\.7 ]]; then
		# Two deletes during 5.7 backup: $backup_dir_sst_info & $backup_dir
		local deletes_num
		deletes_num=$(kubectl_bin logs ${backup_pod} | grep -c 'Delete completed.')
		if [[ ${deletes_num} -ge '2' ]]; then
			echo "Bucket cleanup was successful"
		else
			echo "Something went wrong. Delete was performed for $deletes_num. Expected: 2."
			kubectl_bin logs ${backup_pod}
			exit 1
		fi
	else
		if kubectl_bin logs ${backup_pod} | grep 'Object deleted successfully before attempt 1. Exiting.'; then
			echo "Something went wrong. Delete was not performed."
			kubectl_bin logs ${backup_pod}
			exit 1
		else
			echo "Cleanup was performed."
		fi
	fi
}

check_optins_in_restore_pod() {
	local restore_name=$1
